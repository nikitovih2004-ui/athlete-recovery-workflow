# Copy to .env and fill only the integrations you explicitly enable.
# Secret and identifying values are intentionally blank.

# WHOOP OAuth
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_REFRESH_MARGIN_SECONDS=
WHOOP_ENV_FILE=
WHOOP_TRANSFER_MARKER=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

# Gemini / relay. Outbound AI features remain disabled below.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_VISION_MODEL=
GEMINI_VISION_FALLBACK_MODELS=
GEMINI_TRANSPORT=
GEMINI_RELAY_URL=
GEMINI_RELAY_SECRET=

# Privacy-sensitive feature flags: opt in explicitly after reading PRIVACY.md.
CONVERSATIONAL_ROUTER_ENABLED=false
LEGACY_DESTRUCTIVE_TEXT_ENABLED=false
CONVERSATION_MEMORY_ENABLED=false
CONVERSATION_ANALYTICS_V2_ENABLED=false
BOUNDED_GEMINI_AGENT_ENABLED=false
DAILY_FACTOR_CAPTURE_ENABLED=false
WEEKLY_ANALYSIS_V2_ENABLED=false
GEMINI_VISION_ENABLED=false

# Optional legacy import. Treat the URL as a sensitive capability.
WHOOP_EVENING_CSV_URL=

# Deployment
VPS_HOST=
VPS_IP=
VPS_PORT=
VPS_USER=
VPS_PASSWORD=
VPS_SSH_KEY=
VPS_KNOWN_HOSTS=
VPS_REMOTE_DIR=
WHOOP_SERVICE_USER=

# Standalone relay service
RELAY_BEARER_TOKEN=
GEMINI_ALLOWED_MODELS=
VERTEX_PROJECT_ID=
RELAY_MAX_REQUEST_BYTES=
RELAY_MAX_IMAGE_BYTES=
RELAY_TIMEOUT_SECONDS=
PORT=
